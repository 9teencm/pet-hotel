@startuml PetHotel Pro State Diagram
skinparam monochrome false
skinparam shadowing false
skinparam state {
  BackgroundColor #f8fafc
  BorderColor #94a3b8
  FontName Arial
  ArrowColor #64748b
}

' ─── 預約 Booking ───────────────────────────────
state "預約流程 Booking" as Booking {
  [*] --> pending

  state "待審核\npending"     as pending    #fef3c7
  state "已確認\nconfirmed"   as confirmed  #d1fae5
  state "已入住\nchecked_in"  as checked_in #dbeafe
  state "已退房\nchecked_out" as checked_out #f1f5f9
  state "已取消\ncancelled"   as cancelled  #fee2e2

  pending    --> confirmed   : 前台確認
  confirmed  --> checked_in  : 辦理入住
  checked_in --> checked_out : 辦理退房
  checked_out --> [*]

  pending   --> cancelled : 取消預約
  confirmed --> cancelled : 取消預約
  cancelled --> [*]
}

' ─── 房間 Room ──────────────────────────────────
state "房間狀態 Room" as Room {
  [*] --> available

  state "有空床\navailable" as available #d1fae5
  state "已預約\nreserved"  as reserved  #fef3c7
  state "住宿中\noccupied"  as occupied  #dbeafe
  state "清潔中\ncleaning"  as cleaning  #fae8ff

  available --> reserved  : 預約建立
  reserved  --> available : 預約取消
  reserved  --> occupied  : 辦理入住
  occupied  --> cleaning  : 辦理退房
  cleaning  --> available : 清潔完成
}

' ─── 美容 Grooming ──────────────────────────────
state "美容服務 Grooming" as Grooming {
  [*] --> waiting

  state "等待中\nwaiting"   as waiting   #fef3c7
  state "美容中\ngrooming"  as grooming  #dbeafe
  state "乾燥中\ndrying"    as drying    #fae8ff
  state "已完成\ncompleted" as completed #d1fae5

  waiting   --> grooming  : 開始美容
  grooming  --> drying    : 吹乾階段
  drying    --> completed : 完成
  completed --> [*]

  completed : 美容師拍照上傳\n系統通知飼主
}

@enduml
